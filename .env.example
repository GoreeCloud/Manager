# Examples only. Configure via encrypted Cloudflare Pages secrets.
# Cloudflare Access is mandatory: both values MUST be set before API usage.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-access-app-audience

# GitHub public repositories work without a token.
GITHUB_OWNER=GoreeCloud
# GITHUB_READ_TOKEN=optional-fine-grained-read-only-token

# Optional: Cloudflare Pages analytics (Pages:Read only).
# CF_ACCOUNT_ID=your-account-id
# CF_PAGES_READ_TOKEN=your-read-only-token

# Optional: OpenAI organization usage and costs.
# WARNING: OpenAI currently requires an organization admin key for these endpoints.
# OPENAI_ADMIN_KEY=store-as-cloudflare-encrypted-secret-only
